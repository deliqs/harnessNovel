# Reference novel extraction (init flow; flash model recommended)
DATA_BUILDER_MODEL=deepseek-v4-flash
DATA_BUILDER_BASE_URL=https://api.deepseek.com
DATA_BUILDER_API_KEY=sk-xxxxxxxxxx

# Book and stage design (pro model recommended)
ADAPTIVE_BUILDER_MODEL=deepseek-v4-pro
ADAPTIVE_BUILDER_BASE_URL=https://api.deepseek.com
ADAPTIVE_BUILDER_API_KEY=sk-xxxxxxxxxx

# Story arcs and chapter outlines. This is also the fallback for each optional role below.
ADAPTIVE_BUILDER_LITE_MODEL=deepseek-v4-flash
ADAPTIVE_BUILDER_LITE_BASE_URL=https://api.deepseek.com
ADAPTIVE_BUILDER_LITE_API_KEY=sk-xxxxxxxxxx

# Optional production roles. Omit any field to inherit the corresponding Lite value.
# DRAFT_MODEL=
# DRAFT_BASE_URL=
# DRAFT_API_KEY=
# EDITOR_MODEL=
# EDITOR_BASE_URL=
# EDITOR_API_KEY=
# CRITIC_MODEL=
# CRITIC_BASE_URL=
# CRITIC_API_KEY=

# Prompt diagnostics: off, metadata (default), or full. Full saves bounded, redacted prompts locally.
HARNESS_NOVEL_PROMPT_TRACE_MODE=metadata
